# Sentinela — variáveis de ambiente (copie para .env e preencha)

# --- Câmeras (os IPs ficam no go2rtc/go2rtc.yaml; aqui só as credenciais) ---
# Yoosee (.12 portão, .15, .18) — usuário "admin", senha definida no app YooSee:
CAM_YOOSEE_PASS=changeme
# iCSee (.66) — usuário e senha do dispositivo (app iCSee):
CAM_ICSEE_USER=admin
CAM_ICSEE_PASS=

# --- Backend ---
SENTINELA_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
SENTINELA_ADMIN_USER=admin
SENTINELA_ADMIN_PASS=changeme
GO2RTC_URL=http://localhost:1984
DATABASE_URL=sqlite:///./data/sentinela.db

# --- Notificação (ntfy) ---
# Use um tópico secreto longo e aleatório. Assine este tópico no app ntfy do iPhone.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=sentinela-troque-por-algo-secreto-e-aleatorio
# URL pública (via Tailscale) usada no deep-link da notificação:
APP_PUBLIC_URL=https://sentinela.SEU-TAILNET.ts.net

# --- IA ---
AI_FRAME_INTERVAL_SECONDS=5
AI_OPEN_DEBOUNCE_SECONDS=45
AI_CONFIDENCE_THRESHOLD=0.8
