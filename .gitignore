# Secrets / env
.env
*.env.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Cobertura de testes
.coverage
htmlcov/
coverage/
frontend/coverage/

# Wheels baixados / artefatos pip
*.whl

# Banco / dados
backend/data/
*.db
*.sqlite3

# IA — datasets e pesos (grandes, não versionar)
ai/data/
*.pt
*.onnx
*.tflite

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/

# TypeScript build artifacts (emitidos por `tsc -b`)
*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# go2rtc runtime — o go2rtc reescreve este arquivo (grava streams com senha
# resolvida). Versionamos só o template go2rtc.yaml.example.
go2rtc/*.log
go2rtc/go2rtc.yaml

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
